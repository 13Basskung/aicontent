{
  "name": "content-auto-post-desktop",
  "version": "1.6.88",
  "description": "Desktop Agent for Content Auto Post - Automate content creation with Playwright",
  "main": "electron/main.js",
  "author": "Content Auto Post",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/13Basskung/aicontent.git"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"wait-on http://localhost:3000 && npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "electron .",
    "build": "vite build && npm run electron:build",
    "electron:build": "electron-builder --win --publish never",
    "electron:publish": "electron-builder --win --publish always",
    "postinstall": "electron-builder install-app-deps && playwright install chromium"
  },
  "build": {
    "appId": "com.contentautopost.desktop",
    "productName": "Content Auto Post",
    "artifactName": "ContentAutoPost-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/playwright-core/.local-browsers",
        "to": "browsers",
        "filter": ["chromium*/**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signingHashAlgorithms": []
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Content Auto Post"
    },
    "publish": {
      "provider": "github",
      "owner": "13Basskung",
      "repo": "aicontent",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "firebase": "^10.7.1",
    "playwright": "^1.40.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "lucide-react": "^0.303.0",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.10",
    "wait-on": "^7.2.0"
  }
}
